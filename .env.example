# DreamRiver — environment variables
# Copy to .env.local for development. NEVER commit real values.
# ★ = NEW in feature/growth-batch-1 (July 2026)

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only, never NEXT_PUBLIC

# ── OpenAI / image generation ─────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_DEEP=                    # ★ per-tier override (deep); falls back to OPENAI_MODEL
OPENAI_MODEL_PROFOUND=                # ★ per-tier override (profound); falls back to OPENAI_MODEL
OPENAI_FALLBACK_MODELS=               # comma-separated fallback chain
OPENROUTER_API_KEY=                   # ★ cross-provider failover — dark until set
OPENROUTER_MODEL=                     # ★ any OpenRouter slug; default anthropic/claude-3.5-haiku
BFL_API_KEY=                          # FLUX dream images

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_VISIONARY_MONTHLY=
STRIPE_PRICE_VISIONARY_YEARLY=
STRIPE_PRICE_PROPHET_MONTHLY=
STRIPE_PRICE_PROPHET_YEARLY=

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=                       # master switch — all emails no-op without it
EMAIL_FROM="DreamRiver <hello@dreamriver.io>"   # ★ domain must be verified in Resend
SUPPORT_EMAIL=DreamRiverTechnologies@gmail.com   # ★ feedback widget + reply-to

# ── Analytics (PostHog) ★ ─────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=              # phc_… — client (consent-gated)
POSTHOG_KEY=                          # same value — server events
NEXT_PUBLIC_POSTHOG_HOST=             # optional, default https://us.i.posthog.com
POSTHOG_HOST=                         # optional, default https://us.i.posthog.com

# ── Cron / retention ★ ────────────────────────────────────
CRON_SECRET=                          # openssl rand -hex 32; Vercel sends as Bearer; also signs unsubscribe tokens

# ── Monitoring (Sentry) ───────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Security / limits ─────────────────────────────────────
DREAM_ENCRYPTION_KEY=
DREAM_DAILY_LIMIT=20
GLOBAL_DAILY_DREAM_CAP=
SUBSCRIBE_HOURLY_LIMIT=100
ADMIN_EMAIL_ALLOWLIST=                # comma-separated admin emails

# ── Feature flags / debug ─────────────────────────────────
NEXT_PUBLIC_FEATURE_SERVER_SEARCH=
DEBUG=
